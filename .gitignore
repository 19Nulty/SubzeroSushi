# Source Art (raw art only)
# =========================
SourceArt/**/*.png
SourceArt/**/*.tga

# =========================
# Map build data (regenerated)
# =========================
*_BuiltData.uasset

# =========================
# Allow important Build files
# =========================
!Build/**/
!Build/**/PakBlacklist*.txt
!Build/**/*.ico

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db

